        {
          "name": "Listar miembros (guarda el primero)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const v = json[0] && json[0].id;",
                  "  if (v) { pm.collectionVariables.set(\"miembroId\", v); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/miembros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "miembros"
              ]
            },
            "description": "Guarda el id del primer miembro en {{miembroId}}."
          }
        },
