Rutina, SesionEntrenamiento, RegistroSerie&lt;br&gt;MedicionCorporal&lt;br&gt;Enumeraciones: TipoObjetivo, EstadoObjetivo,&lt;br&gt;GrupoMuscular, NivelRutina, DiaSemana, EstadoAsignacion" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=2;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c131"><mxGeometry x="0" y="34" width="420" height="100" as="geometry"/></mxCell><mxCell id="c133" value="dto (records de entrada y salida)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=34;html=1;whiteSpace=wrap;fontSize=11;collapsible=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="490" y="2165" width="420" height="119" as="geometry"/></mxCell><mxCell id="c134" value="UsuarioDtos (MiembroRequest, MiembroUpdateRequest,&lt;br&gt;EntrenadorRequest, MiembroResponse, EntrenadorResponse)&lt;br&gt;EjercicioDtos · ObjetivoDtos · RutinaDtos&lt;br&gt;SesionDtos · MedicionDtos · PanelDtos&lt;br&gt;ErrorResponse (cuerpo estándar de error)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=2;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c133"><mxGeometry x="0" y="34" width="420" height="85" as="geometry"/></mxCell><mxCell id="c135" value="exception" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=34;html=1;whiteSpace=wrap;fontSize=11;collapsible=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="950" y="2165" width="380" height="119" as="geometry"/></mxCell><mxCell id="c136" value="GlobalExceptionHandler (@RestControllerAdvice)&lt;br&gt;RecursoNoEncontradoException → 404&lt;br&gt;ConflictoException → 409&lt;br&gt;ReglaDeNegocioException → 400&lt;br&gt;OperacionNoPermitidaException → 403" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=2;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c135"><mxGeometry x="0" y="34" width="380" height="85" as="geometry"/></mxCell><mxCell id="c137" value="config" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=34;html=1;whiteSpace=wrap;fontSize=11;collapsible=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1370" y="2165" width="380" height="104" as="geometry"/></mxCell><mxCell id="c138" value="GymTrackApplication (main)&lt;br&gt;ClockConfig (Clock inyectable)&lt;br&gt;CorsConfig (orígenes 5173 y 4173)&lt;br&gt;DataSeeder (datos de ejemplo al arrancar)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=2;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c137"><mxGeometry x="0" y="34" width="380" height="70" as="geometry"/></mxCell><mxCell id="c139" value="Vista de desarrollo: organización del código. Azul = backend (Controller → Service → Repository; el dominio model no es una capa), morado = patrón Strategy, naranja = repositorios Spring Data, verde = frontend. Las flechas van en un solo sentido y sin ciclos. La flecha roja es la única unión entre repositorios: ocurre en ejecución (HTTP/JSON), no en compilación. Triángulo hueco discontinuo = realiza una interfaz. Los grupos de abajo (model, dto, exception, config) los usan todas las capas y no se dibujan con flechas para no saturar el diagrama." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="30" y="2385" width="1500" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>