<mxfile host="app.diagrams.net"><diagram id="d" name="1. Vista de contexto"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Vista de contexto de GymTrack: diagrama de contexto (flujos de datos)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="900" height="26" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Miembro&lt;/b&gt;&lt;br&gt;(entidad externa)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="30" y="220" width="210" height="150" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Entrenador&lt;/b&gt;&lt;br&gt;(entidad externa)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1240" y="220" width="210" height="150" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;GymTrack&lt;/b&gt;&lt;br&gt;(sistema de seguimiento&lt;br&gt;de entrenamiento)" style="ellipse;whiteSpace=wrap;html=1;fontSize=15;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="570" y="130" width="340" height="340" as="geometry"/></mxCell><mxCell id="c5" value="Datos de cuenta y perfil (HU-01, 03)&lt;br&gt;Objetivos (HU-04)&lt;br&gt;Sesiones de entrenamiento (HU-13)&lt;br&gt;Mediciones corporales (HU-15)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;labelBackgroundColor=#FFFFFF;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.3;entryX=0.047;entryY=0.289;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="Panel de progreso (HU-17)&lt;br&gt;Progreso de objetivos (HU-05, 06)&lt;br&gt;Historial de sesiones (HU-14)&lt;br&gt;Evolución corporal (HU-16)&lt;br&gt;Catálogo y rutina activa (HU-07, 10, 12)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;labelBackgroundColor=#FFFFFF;exitPerimeter=0;entryPerimeter=0;exitX=0.047;exitY=0.711;entryX=1;entryY=0.75;" edge="1" parent="1" source="c4" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="Datos de cuenta (HU-02)&lt;br&gt;Ejercicios nuevos (HU-08)&lt;br&gt;Rutinas diseñadas (HU-09)&lt;br&gt;Asignaciones de rutina (HU-11)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;labelBackgroundColor=#FFFFFF;exitPerimeter=0;entryPerimeter=0;exitX=0;exitY=0.3;entryX=0.953;entryY=0.289;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="Catálogo de ejercicios (HU-07)&lt;br&gt;Rutinas existentes (HU-10)&lt;br&gt;Miembros registrados (HU-11)&lt;br&gt;Confirmaciones y errores de validación" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;labelBackgroundColor=#FFFFFF;exitPerimeter=0;entryPerimeter=0;exitX=0.953;exitY=0.711;entryX=0;entryY=0.75;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="Vista de contexto (Bloque 2). GymTrack es una caja negra: solo se muestran las dos entidades externas de las historias de usuario (Miembro y Entrenador) y los datos que intercambian con el sistema. MongoDB, Spring y React no aparecen: son solución tecnológica y se ven en las vistas funcional, de desarrollo y de despliegue. Sin autenticación (fuera de alcance)." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="1000" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>