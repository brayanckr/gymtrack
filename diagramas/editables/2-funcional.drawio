xCell id="c45" value="" style="endArrow=halfCircle;endFill=0;endSize=14;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="" style="endArrow=halfCircle;endFill=0;endSize=14;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="" style="endArrow=halfCircle;endFill=0;endSize=14;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="" style="endArrow=halfCircle;endFill=0;endSize=14;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="Vista funcional (Bloque 5): diagrama de componentes. Cada componente agrupa las historias de usuario que resuelve y ofrece una interfaz provista (círculo). El semicírculo (socket) indica la interfaz requerida: «A → B» significa que A necesita la interfaz de B. El cuadro pequeño es el puerto de servicio de la API. Los actores usan la interfaz web. No es un diagrama de casos de uso." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="30" y="1140" width="900" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>