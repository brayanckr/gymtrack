c37" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c10" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c13" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c13" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="Vista funcional: cada componente agrupa las historias de usuario que resuelve y expone una interfaz (círculo). La flecha discontinua «A → B» significa que A usa la interfaz de B. El grafo es acíclico. Usuarios valida miembro/entrenador; Catálogo valida ejercicios; Rutinas aporta la rutina opcional de una sesión (RN-14); Progreso reúne los datos para calcular el avance (RN-07). No es un diagrama de casos de uso." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="30" y="1000" width="820" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>