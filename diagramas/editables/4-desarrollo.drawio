ue los reales." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="900" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>